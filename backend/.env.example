# Copy this file to .env and adjust.
# Leave DATABASE_URL unset to use a local SQLite file (tasks.db).
# Local Postgres (docker-compose):
# DATABASE_URL=postgresql://taskuser:taskpass@localhost:5432/taskdb
# Neon (production) - paste the connection string from the Neon dashboard:
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173
